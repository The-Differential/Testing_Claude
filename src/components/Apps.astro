---

<section id="apps" class="apps">
  <div class="container">
    <div class="section-header">
      <h2 class="section-title">Our Medical Apps</h2>
      <p class="section-description">
        Two powerful apps designed for healthcare professionals
      </p>
    </div>

    <div class="apps-grid">
      <!-- Drugs App -->
      <div class="app-card">
        <div class="app-icon drugs">
          <svg width="60" height="60" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="10"></circle>
            <circle cx="12" cy="12" r="6"></circle>
            <line x1="12" y1="2" x2="12" y2="6"></line>
            <line x1="12" y1="18" x2="12" y2="22"></line>
            <line x1="4.93" y1="4.93" x2="7.76" y2="7.76"></line>
            <line x1="16.24" y1="16.24" x2="19.07" y2="19.07"></line>
            <line x1="2" y1="12" x2="6" y2="12"></line>
            <line x1="18" y1="12" x2="22" y2="12"></line>
            <line x1="4.93" y1="19.07" x2="7.76" y2="16.24"></line>
            <line x1="16.24" y1="7.76" x2="19.07" y2="4.93"></line>
          </svg>
        </div>
        <h3 class="app-title">Drugs</h3>
        <p class="app-tagline">Comprehensive Dosing Guide</p>
        <p class="app-description">
          Access detailed dosing instructions for thousands of medications. Including pediatric doses,
          renal adjustments, hepatic adjustments, and special populations.
        </p>
        <ul class="app-features">
          <li>
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
            <span>Detailed dosing protocols</span>
          </li>
          <li>
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
            <span>Drug interactions checker</span>
          </li>
          <li>
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
            <span>Renal & hepatic adjustments</span>
          </li>
          <li>
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
            <span>Pediatric & geriatric dosing</span>
          </li>
          <li>
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
            <span>Contraindications & warnings</span>
          </li>
        </ul>
        <a href="#download" class="app-button">
          Download App
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>
      </div>

      <!-- Medical Numbers App -->
      <div class="app-card">
        <div class="app-icon medical-numbers">
          <svg width="60" height="60" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
            <line x1="3" y1="9" x2="21" y2="9"></line>
            <line x1="9" y1="21" x2="9" y2="9"></line>
            <path d="M14 13h2v2h-2z"></path>
            <path d="M14 17h2v2h-2z"></path>
          </svg>
        </div>
        <h3 class="app-title">Medical Numbers</h3>
        <p class="app-tagline">Clinical Calculators & Formulas</p>
        <p class="app-description">
          Essential medical calculators, scores, and formulas for clinical decision-making.
          From cardiac risk scores to pharmacokinetic calculations.
        </p>
        <ul class="app-features">
          <li>
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
            <span>100+ clinical calculators</span>
          </li>
          <li>
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
            <span>Risk scores & probability tools</span>
          </li>
          <li>
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
            <span>Unit conversions</span>
          </li>
          <li>
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
            <span>Evidence-based formulas</span>
          </li>
          <li>
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
            <span>Reference ranges</span>
          </li>
        </ul>
        <a href="#download" class="app-button">
          Download App
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .apps {
    padding: var(--spacing-xl) 0;
    background: linear-gradient(180deg, white 0%, var(--color-surface) 100%);
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 var(--spacing-md);
  }

  .section-header {
    text-align: center;
    margin-bottom: var(--spacing-lg);
  }

  .section-title {
    font-size: 2.5rem;
    margin-bottom: var(--spacing-sm);
    color: var(--color-text);
  }

  .section-description {
    font-size: 1.25rem;
    color: var(--color-text-light);
  }

  .apps-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(400px, 1fr));
    gap: var(--spacing-md);
  }

  .app-card {
    background: white;
    padding: var(--spacing-lg);
    border-radius: var(--radius);
    box-shadow: var(--shadow-md);
    transition: all 0.3s;
    border: 2px solid transparent;
  }

  .app-card:hover {
    transform: translateY(-8px);
    box-shadow: var(--shadow-lg);
    border-color: var(--color-primary);
  }

  .app-icon {
    width: 100px;
    height: 100px;
    border-radius: 20px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: var(--spacing-sm);
  }

  .app-icon.drugs {
    background: linear-gradient(135deg, #0066cc, #00a3bf);
  }

  .app-icon.medical-numbers {
    background: linear-gradient(135deg, #00a3bf, #00c9a7);
  }

  .app-icon svg {
    color: white;
  }

  .app-title {
    font-size: 2rem;
    margin-bottom: var(--spacing-xs);
    color: var(--color-text);
  }

  .app-tagline {
    font-size: 1rem;
    color: var(--color-primary);
    font-weight: 600;
    margin-bottom: var(--spacing-sm);
  }

  .app-description {
    color: var(--color-text-light);
    line-height: 1.6;
    margin-bottom: var(--spacing-md);
  }

  .app-features {
    list-style: none;
    margin-bottom: var(--spacing-md);
  }

  .app-features li {
    display: flex;
    align-items: center;
    gap: var(--spacing-xs);
    margin-bottom: var(--spacing-xs);
    color: var(--color-text);
  }

  .app-features svg {
    color: var(--color-success);
    flex-shrink: 0;
  }

  .app-button {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: var(--color-primary);
    color: white;
    padding: 1rem 2rem;
    border-radius: var(--radius);
    font-weight: 600;
    transition: all 0.3s;
    width: 100%;
    justify-content: center;
  }

  .app-button:hover {
    background: var(--color-primary-dark);
    transform: translateX(4px);
  }

  @media (max-width: 768px) {
    .section-title {
      font-size: 2rem;
    }

    .apps-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
