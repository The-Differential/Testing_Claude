---

<section id="download" class="download">
  <div class="container">
    <div class="download-content">
      <div class="download-text">
        <h2 class="download-title">Ready to Get Started?</h2>
        <p class="download-description">
          Join thousands of healthcare professionals using our trusted medical tools.
          Download now and get access to comprehensive drug information and clinical calculators.
        </p>
        <div class="download-badges">
          <a href="https://apps.apple.com" class="badge-link" target="_blank" rel="noopener">
            <div class="app-store-badge">
              <svg width="30" height="30" viewBox="0 0 24 24" fill="currentColor">
                <path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z"/>
              </svg>
              <div class="badge-text">
                <div class="badge-subtitle">Download on the</div>
                <div class="badge-title">App Store</div>
              </div>
            </div>
          </a>
        </div>
        <div class="download-stats">
          <div class="stat">
            <div class="stat-number">10,000+</div>
            <div class="stat-label">Active Users</div>
          </div>
          <div class="stat">
            <div class="stat-number">4.8★</div>
            <div class="stat-label">Average Rating</div>
          </div>
          <div class="stat">
            <div class="stat-number">5000+</div>
            <div class="stat-label">Medications</div>
          </div>
        </div>
      </div>
      <div class="download-visual">
        <div class="phones-group">
          <div class="phone phone-1">
            <div class="phone-content">
              <div class="app-screen drugs-screen"></div>
            </div>
          </div>
          <div class="phone phone-2">
            <div class="phone-content">
              <div class="app-screen medical-screen"></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .download {
    padding: var(--spacing-xl) 0;
    background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-secondary) 100%);
    color: white;
    position: relative;
    overflow: hidden;
  }

  .download::before {
    content: '';
    position: absolute;
    top: -50%;
    left: -20%;
    width: 500px;
    height: 500px;
    background: radial-gradient(circle, rgba(255, 255, 255, 0.1) 0%, transparent 70%);
    border-radius: 50%;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 var(--spacing-md);
    position: relative;
  }

  .download-content {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--spacing-xl);
    align-items: center;
  }

  .download-title {
    font-size: 3rem;
    margin-bottom: var(--spacing-sm);
  }

  .download-description {
    font-size: 1.25rem;
    margin-bottom: var(--spacing-md);
    opacity: 0.9;
    line-height: 1.6;
  }

  .download-badges {
    margin-bottom: var(--spacing-md);
  }

  .badge-link {
    display: inline-block;
  }

  .app-store-badge {
    display: flex;
    align-items: center;
    gap: var(--spacing-sm);
    background: rgba(0, 0, 0, 0.3);
    padding: var(--spacing-sm) var(--spacing-md);
    border-radius: var(--radius);
    border: 2px solid rgba(255, 255, 255, 0.2);
    transition: all 0.3s;
    backdrop-filter: blur(10px);
  }

  .app-store-badge:hover {
    background: rgba(0, 0, 0, 0.5);
    border-color: white;
    transform: translateY(-2px);
  }

  .badge-text {
    text-align: left;
  }

  .badge-subtitle {
    font-size: 0.75rem;
    opacity: 0.8;
  }

  .badge-title {
    font-size: 1.25rem;
    font-weight: 600;
  }

  .download-stats {
    display: flex;
    gap: var(--spacing-lg);
  }

  .stat {
    text-align: left;
  }

  .stat-number {
    font-size: 2rem;
    font-weight: 700;
  }

  .stat-label {
    font-size: 0.875rem;
    opacity: 0.8;
  }

  .download-visual {
    position: relative;
    display: flex;
    justify-content: center;
    align-items: center;
    height: 500px;
  }

  .phones-group {
    position: relative;
    width: 100%;
    height: 100%;
  }

  .phone {
    position: absolute;
    width: 200px;
    height: 400px;
    background: #1a1a1a;
    border-radius: 30px;
    padding: 10px;
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.3);
    transition: transform 0.3s;
  }

  .phone-1 {
    top: 50%;
    left: 20%;
    transform: translateY(-50%) rotate(-5deg);
    z-index: 2;
  }

  .phone-2 {
    top: 50%;
    right: 20%;
    transform: translateY(-50%) rotate(5deg);
    z-index: 1;
  }

  .phone:hover {
    transform: translateY(-50%) rotate(0deg) scale(1.05);
  }

  .phone-content {
    width: 100%;
    height: 100%;
    background: white;
    border-radius: 24px;
    overflow: hidden;
  }

  .app-screen {
    width: 100%;
    height: 100%;
  }

  .drugs-screen {
    background: linear-gradient(180deg, var(--color-primary) 0%, var(--color-surface) 30%, white 100%);
  }

  .medical-screen {
    background: linear-gradient(180deg, var(--color-secondary) 0%, var(--color-surface) 30%, white 100%);
  }

  @media (max-width: 968px) {
    .download-content {
      grid-template-columns: 1fr;
      gap: var(--spacing-md);
    }

    .download-title {
      font-size: 2rem;
    }

    .download-visual {
      height: 300px;
    }

    .phone {
      width: 150px;
      height: 300px;
    }

    .download-stats {
      flex-wrap: wrap;
    }
  }
</style>
