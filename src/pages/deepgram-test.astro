---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Deepgram Nova-3 Medical - Speech Test" description="Test Deepgram Nova-3 Medical speech-to-text transcription">
  <div class="container">
    <header class="page-header">
      <h1>Deepgram Nova-3 Medical</h1>
      <p class="subtitle">Real-time Medical Speech-to-Text Testing</p>
    </header>

    <div class="controls-panel">
      <div class="config-row">
        <div class="config-group" style="flex: 2; min-width: 280px;">
          <label for="api-key">Deepgram API Key</label>
          <div style="display: flex; gap: 0.4rem;">
            <input type="password" id="api-key" placeholder="Enter your Deepgram API key" style="flex:1; padding: 0.5rem; border: 1px solid var(--color-border); border-radius: 6px; font-size: 0.9rem;" />
            <button id="btn-toggle-key" class="btn btn-secondary btn-sm" type="button" style="white-space:nowrap;">Show</button>
          </div>
          <p style="font-size: 0.75rem; color: var(--color-text-light); margin-top: 0.25rem;">Get a key at <a href="https://console.deepgram.com" target="_blank" rel="noopener">console.deepgram.com</a>. Stored locally in your browser only.</p>
        </div>
      </div>
      <div class="config-row">
        <div class="config-group">
          <label for="language">Language</label>
          <select id="language">
            <option value="en-US">English (US)</option>
            <option value="en-GB">English (UK)</option>
            <option value="en-AU">English (AU)</option>
          </select>
        </div>
        <div class="config-group">
          <label for="encoding">Encoding</label>
          <select id="encoding">
            <option value="linear16">Linear16</option>
            <option value="opus">Opus</option>
          </select>
        </div>
        <div class="config-group">
          <label for="sample-rate">Sample Rate</label>
          <select id="sample-rate">
            <option value="16000">16000 Hz</option>
            <option value="44100">44100 Hz</option>
            <option value="48000">48000 Hz</option>
          </select>
        </div>
      </div>

      <div class="config-row">
        <div class="toggle-group">
          <label class="toggle-label">
            <input type="checkbox" id="smart-format" checked />
            <span>Smart Format</span>
          </label>
          <label class="toggle-label">
            <input type="checkbox" id="punctuate" checked />
            <span>Punctuation</span>
          </label>
          <label class="toggle-label">
            <input type="checkbox" id="diarize" />
            <span>Diarization</span>
          </label>
          <label class="toggle-label">
            <input type="checkbox" id="utterances" />
            <span>Utterances</span>
          </label>
        </div>
      </div>

      <div class="button-row">
        <button id="btn-record" class="btn btn-primary">
          <span class="btn-icon">&#9679;</span>
          Start Recording
        </button>
        <button id="btn-stop" class="btn btn-danger" disabled>
          <span class="btn-icon">&#9632;</span>
          Stop
        </button>
        <button id="btn-clear" class="btn btn-secondary">
          Clear
        </button>
      </div>

      <div id="status" class="status">Ready. Click "Start Recording" to begin.</div>
    </div>

    <div class="results-grid">
      <div class="result-card">
        <h2>Live Transcript <span class="badge" id="interim-badge">Interim</span></h2>
        <div id="interim-transcript" class="transcript-box">
          <p class="placeholder">Interim results will appear here...</p>
        </div>
      </div>

      <div class="result-card">
        <h2>Final Transcript <span class="badge badge-success" id="final-badge">Final</span></h2>
        <div id="final-transcript" class="transcript-box transcript-final">
          <p class="placeholder">Final transcription will appear here...</p>
        </div>
        <button id="btn-copy" class="btn btn-sm btn-secondary" style="margin-top: 0.5rem;">Copy to Clipboard</button>
      </div>
    </div>

    <div class="result-card">
      <h2>Upload Audio File</h2>
      <p class="upload-desc">Upload a pre-recorded audio file for transcription using Nova-3 Medical.</p>
      <div class="upload-area" id="upload-area">
        <input type="file" id="file-input" accept="audio/*" hidden />
        <p>Drag & drop an audio file here, or <button class="link-btn" id="btn-browse">browse</button></p>
        <p class="upload-hint">Supports WAV, MP3, FLAC, OGG, M4A</p>
      </div>
      <div id="upload-status" class="status" style="display:none;"></div>
      <div id="file-transcript" class="transcript-box" style="display:none;">
        <p class="placeholder">File transcription will appear here...</p>
      </div>
    </div>

    <div class="result-card metadata-card">
      <h2>Connection Info</h2>
      <div id="connection-info" class="metadata">
        <div class="meta-item"><span class="meta-label">Status:</span> <span id="ws-status">Disconnected</span></div>
        <div class="meta-item"><span class="meta-label">Model:</span> <span>nova-3-medical</span></div>
        <div class="meta-item"><span class="meta-label">Messages Received:</span> <span id="msg-count">0</span></div>
        <div class="meta-item"><span class="meta-label">Duration:</span> <span id="duration">0s</span></div>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .container {
    max-width: 960px;
    margin: 0 auto;
    padding: var(--spacing-md);
  }

  .page-header {
    text-align: center;
    margin-bottom: var(--spacing-lg);
  }

  .page-header h1 {
    font-size: 2rem;
    color: var(--color-primary);
    margin-bottom: 0.25rem;
  }

  .subtitle {
    color: var(--color-text-light);
    font-size: 1.1rem;
  }

  .controls-panel {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: var(--spacing-md);
    margin-bottom: var(--spacing-md);
  }

  .config-row {
    display: flex;
    gap: var(--spacing-sm);
    flex-wrap: wrap;
    margin-bottom: var(--spacing-sm);
  }

  .config-group {
    flex: 1;
    min-width: 140px;
  }

  .config-group label {
    display: block;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--color-text-light);
    margin-bottom: 0.25rem;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .config-group select {
    width: 100%;
    padding: 0.5rem;
    border: 1px solid var(--color-border);
    border-radius: 6px;
    font-size: 0.9rem;
    background: white;
  }

  .toggle-group {
    display: flex;
    gap: var(--spacing-sm);
    flex-wrap: wrap;
  }

  .toggle-label {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.9rem;
    cursor: pointer;
  }

  .button-row {
    display: flex;
    gap: var(--spacing-sm);
    margin-top: var(--spacing-sm);
  }

  .btn {
    padding: 0.6rem 1.5rem;
    border: none;
    border-radius: 8px;
    font-size: 0.95rem;
    font-weight: 600;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 0.4rem;
    transition: all 0.2s;
  }

  .btn:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .btn-primary {
    background: var(--color-primary);
    color: white;
  }

  .btn-primary:hover:not(:disabled) {
    background: var(--color-primary-dark);
  }

  .btn-danger {
    background: #dc3545;
    color: white;
  }

  .btn-danger:hover:not(:disabled) {
    background: #c82333;
  }

  .btn-secondary {
    background: var(--color-border);
    color: var(--color-text);
  }

  .btn-secondary:hover:not(:disabled) {
    background: #ccc;
  }

  .btn-sm {
    padding: 0.35rem 0.8rem;
    font-size: 0.85rem;
  }

  .btn-icon {
    font-size: 0.7rem;
  }

  .status {
    margin-top: var(--spacing-sm);
    padding: 0.5rem 0.75rem;
    background: white;
    border: 1px solid var(--color-border);
    border-radius: 6px;
    font-size: 0.85rem;
    color: var(--color-text-light);
  }

  .status.recording {
    background: #fff5f5;
    border-color: #dc3545;
    color: #dc3545;
    animation: pulse 1.5s infinite;
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.7; }
  }

  .results-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--spacing-md);
    margin-bottom: var(--spacing-md);
  }

  @media (max-width: 700px) {
    .results-grid {
      grid-template-columns: 1fr;
    }
  }

  .result-card {
    background: white;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: var(--spacing-md);
    margin-bottom: var(--spacing-md);
  }

  .result-card h2 {
    font-size: 1rem;
    margin-bottom: var(--spacing-sm);
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .badge {
    font-size: 0.7rem;
    padding: 0.15rem 0.5rem;
    border-radius: 20px;
    background: var(--color-primary);
    color: white;
    font-weight: 500;
  }

  .badge-success {
    background: var(--color-success);
  }

  .transcript-box {
    min-height: 150px;
    max-height: 350px;
    overflow-y: auto;
    padding: var(--spacing-sm);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 8px;
    font-size: 0.95rem;
    line-height: 1.7;
    white-space: pre-wrap;
    word-wrap: break-word;
  }

  .transcript-final {
    background: #f0f9f0;
    border-color: #c3e6cb;
  }

  .placeholder {
    color: var(--color-text-light);
    font-style: italic;
  }

  .upload-desc {
    color: var(--color-text-light);
    font-size: 0.9rem;
    margin-bottom: var(--spacing-sm);
  }

  .upload-area {
    border: 2px dashed var(--color-border);
    border-radius: var(--radius);
    padding: var(--spacing-lg) var(--spacing-md);
    text-align: center;
    color: var(--color-text-light);
    transition: border-color 0.2s, background 0.2s;
  }

  .upload-area.dragover {
    border-color: var(--color-primary);
    background: #f0f7ff;
  }

  .upload-hint {
    font-size: 0.8rem;
    margin-top: 0.5rem;
  }

  .link-btn {
    background: none;
    border: none;
    color: var(--color-primary);
    cursor: pointer;
    font-size: inherit;
    text-decoration: underline;
  }

  .metadata {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.5rem;
  }

  .meta-item {
    font-size: 0.9rem;
  }

  .meta-label {
    font-weight: 600;
    color: var(--color-text-light);
  }

  .metadata-card {
    margin-bottom: 0;
  }

  .speaker-label {
    font-weight: 700;
    color: var(--color-primary);
    margin-right: 0.3rem;
  }
</style>

<script>
  const apiKeyInput = document.getElementById('api-key') as HTMLInputElement;
  const btnToggleKey = document.getElementById('btn-toggle-key') as HTMLButtonElement;

  // Restore saved API key from localStorage
  const savedKey = localStorage.getItem('dg_api_key');
  if (savedKey) apiKeyInput.value = savedKey;

  // Toggle key visibility
  btnToggleKey.addEventListener('click', () => {
    const isPassword = apiKeyInput.type === 'password';
    apiKeyInput.type = isPassword ? 'text' : 'password';
    btnToggleKey.textContent = isPassword ? 'Hide' : 'Show';
  });

  // Save key on change
  apiKeyInput.addEventListener('input', () => {
    const key = apiKeyInput.value.trim();
    if (key) {
      localStorage.setItem('dg_api_key', key);
    } else {
      localStorage.removeItem('dg_api_key');
    }
  });

  function getApiKey(): string {
    return apiKeyInput.value.trim();
  }

  const btnRecord = document.getElementById('btn-record') as HTMLButtonElement;
  const btnStop = document.getElementById('btn-stop') as HTMLButtonElement;
  const btnClear = document.getElementById('btn-clear') as HTMLButtonElement;
  const btnCopy = document.getElementById('btn-copy') as HTMLButtonElement;
  const statusEl = document.getElementById('status')!;
  const interimBox = document.getElementById('interim-transcript')!;
  const finalBox = document.getElementById('final-transcript')!;
  const wsStatusEl = document.getElementById('ws-status')!;
  const msgCountEl = document.getElementById('msg-count')!;
  const durationEl = document.getElementById('duration')!;
  const fileInput = document.getElementById('file-input') as HTMLInputElement;
  const uploadArea = document.getElementById('upload-area')!;
  const btnBrowse = document.getElementById('btn-browse')!;
  const uploadStatus = document.getElementById('upload-status')!;
  const fileTranscript = document.getElementById('file-transcript')!;

  let mediaRecorder: MediaRecorder | null = null;
  let socket: WebSocket | null = null;
  let stream: MediaStream | null = null;
  let msgCount = 0;
  let startTime = 0;
  let durationInterval: number | null = null;
  let finalText = '';

  function getWsUrl(): string {
    const lang = (document.getElementById('language') as HTMLSelectElement).value;
    const encoding = (document.getElementById('encoding') as HTMLSelectElement).value;
    const sampleRate = (document.getElementById('sample-rate') as HTMLSelectElement).value;
    const smartFormat = (document.getElementById('smart-format') as HTMLInputElement).checked;
    const punctuate = (document.getElementById('punctuate') as HTMLInputElement).checked;
    const diarize = (document.getElementById('diarize') as HTMLInputElement).checked;
    const utterances = (document.getElementById('utterances') as HTMLInputElement).checked;

    const params = new URLSearchParams({
      model: 'nova-3-medical',
      language: lang,
      encoding: encoding,
      sample_rate: sampleRate,
      smart_format: String(smartFormat),
      punctuate: String(punctuate),
      diarize: String(diarize),
      utterances: String(utterances),
      interim_results: 'true',
      vad_events: 'true',
    });

    return `wss://api.deepgram.com/v1/listen?${params.toString()}`;
  }

  function updateStatus(msg: string, isRecording = false) {
    statusEl.textContent = msg;
    statusEl.className = isRecording ? 'status recording' : 'status';
  }

  function updateDuration() {
    const elapsed = Math.floor((Date.now() - startTime) / 1000);
    const mins = Math.floor(elapsed / 60);
    const secs = elapsed % 60;
    durationEl.textContent = mins > 0 ? `${mins}m ${secs}s` : `${secs}s`;
  }

  async function startRecording() {
    const apiKey = getApiKey();
    if (!apiKey) {
      updateStatus('Please enter your Deepgram API key above.');
      apiKeyInput.focus();
      return;
    }

    try {
      stream = await navigator.mediaDevices.getUserMedia({ audio: true });
    } catch (err) {
      updateStatus('Microphone access denied. Please allow microphone permissions.');
      return;
    }

    msgCount = 0;
    msgCountEl.textContent = '0';
    finalText = '';
    interimBox.innerHTML = '<p class="placeholder">Listening...</p>';
    finalBox.innerHTML = '<p class="placeholder">Waiting for final results...</p>';

    const wsUrl = getWsUrl();
    socket = new WebSocket(wsUrl, ['token', apiKey]);

    wsStatusEl.textContent = 'Connecting...';

    socket.onopen = () => {
      wsStatusEl.textContent = 'Connected';
      updateStatus('Recording... Speak into your microphone.', true);
      startTime = Date.now();
      durationInterval = window.setInterval(updateDuration, 1000);

      mediaRecorder = new MediaRecorder(stream!, { mimeType: 'audio/webm' });
      mediaRecorder.ondataavailable = (e) => {
        if (e.data.size > 0 && socket?.readyState === WebSocket.OPEN) {
          socket.send(e.data);
        }
      };
      mediaRecorder.start(250);

      btnRecord.disabled = true;
      btnStop.disabled = false;
    };

    socket.onmessage = (event) => {
      msgCount++;
      msgCountEl.textContent = String(msgCount);

      const data = JSON.parse(event.data);

      if (data.type === 'Results') {
        const transcript = data.channel?.alternatives?.[0]?.transcript || '';
        const isFinal = data.is_final;
        const speechFinal = data.speech_final;

        if (transcript) {
          const diarize = (document.getElementById('diarize') as HTMLInputElement).checked;
          let displayText = transcript;

          if (diarize && data.channel?.alternatives?.[0]?.words) {
            const words = data.channel.alternatives[0].words;
            let currentSpeaker = -1;
            let parts: string[] = [];
            for (const w of words) {
              if (w.speaker !== currentSpeaker) {
                currentSpeaker = w.speaker;
                parts.push(`\n[Speaker ${w.speaker}]: `);
              }
              parts.push(w.punctuated_word || w.word);
              parts.push(' ');
            }
            displayText = parts.join('').trim();
          }

          if (isFinal) {
            finalText += (finalText ? ' ' : '') + displayText;
            finalBox.textContent = finalText;
            finalBox.scrollTop = finalBox.scrollHeight;

            if (speechFinal) {
              finalText += '\n';
            }
          }

          interimBox.textContent = isFinal ? '' : displayText;
        }
      }
    };

    socket.onerror = (err) => {
      console.error('WebSocket error:', err);
      updateStatus('Connection error. Check API key and try again.');
      wsStatusEl.textContent = 'Error';
      stopRecording();
    };

    socket.onclose = (event) => {
      wsStatusEl.textContent = 'Disconnected';
      if (event.code !== 1000) {
        updateStatus(`Connection closed (code: ${event.code}). ${event.reason || ''}`);
      }
    };
  }

  function stopRecording() {
    if (mediaRecorder && mediaRecorder.state !== 'inactive') {
      mediaRecorder.stop();
    }
    if (socket && socket.readyState === WebSocket.OPEN) {
      socket.send(JSON.stringify({ type: 'CloseStream' }));
      socket.close();
    }
    if (stream) {
      stream.getTracks().forEach(t => t.stop());
      stream = null;
    }
    if (durationInterval) {
      clearInterval(durationInterval);
      durationInterval = null;
    }

    btnRecord.disabled = false;
    btnStop.disabled = true;
    updateStatus('Stopped. Click "Start Recording" to begin again.');
  }

  btnRecord.addEventListener('click', startRecording);
  btnStop.addEventListener('click', stopRecording);

  btnClear.addEventListener('click', () => {
    finalText = '';
    interimBox.innerHTML = '<p class="placeholder">Interim results will appear here...</p>';
    finalBox.innerHTML = '<p class="placeholder">Final transcription will appear here...</p>';
    msgCount = 0;
    msgCountEl.textContent = '0';
    durationEl.textContent = '0s';
  });

  btnCopy.addEventListener('click', () => {
    if (finalText.trim()) {
      navigator.clipboard.writeText(finalText.trim()).then(() => {
        btnCopy.textContent = 'Copied!';
        setTimeout(() => { btnCopy.textContent = 'Copy to Clipboard'; }, 2000);
      });
    }
  });

  // File upload
  btnBrowse.addEventListener('click', () => fileInput.click());

  uploadArea.addEventListener('dragover', (e) => {
    e.preventDefault();
    uploadArea.classList.add('dragover');
  });

  uploadArea.addEventListener('dragleave', () => {
    uploadArea.classList.remove('dragover');
  });

  uploadArea.addEventListener('drop', (e) => {
    e.preventDefault();
    uploadArea.classList.remove('dragover');
    const file = (e as DragEvent).dataTransfer?.files[0];
    if (file) transcribeFile(file);
  });

  fileInput.addEventListener('change', () => {
    const file = fileInput.files?.[0];
    if (file) transcribeFile(file);
  });

  async function transcribeFile(file: File) {
    const apiKey = getApiKey();
    if (!apiKey) {
      uploadStatus.style.display = 'block';
      uploadStatus.textContent = 'Please enter your Deepgram API key above.';
      apiKeyInput.focus();
      return;
    }

    uploadStatus.style.display = 'block';
    uploadStatus.textContent = `Uploading "${file.name}" (${(file.size / 1024 / 1024).toFixed(2)} MB)...`;
    fileTranscript.style.display = 'block';
    fileTranscript.innerHTML = '<p class="placeholder">Transcribing...</p>';

    const lang = (document.getElementById('language') as HTMLSelectElement).value;
    const smartFormat = (document.getElementById('smart-format') as HTMLInputElement).checked;
    const punctuate = (document.getElementById('punctuate') as HTMLInputElement).checked;
    const diarize = (document.getElementById('diarize') as HTMLInputElement).checked;

    const params = new URLSearchParams({
      model: 'nova-3-medical',
      language: lang,
      smart_format: String(smartFormat),
      punctuate: String(punctuate),
      diarize: String(diarize),
    });

    try {
      const response = await fetch(`https://api.deepgram.com/v1/listen?${params.toString()}`, {
        method: 'POST',
        headers: {
          'Authorization': `Token ${apiKey}`,
          'Content-Type': file.type || 'audio/wav',
        },
        body: file,
      });

      if (!response.ok) {
        const errText = await response.text();
        throw new Error(`HTTP ${response.status}: ${errText}`);
      }

      const data = await response.json();
      const transcript = data.results?.channels?.[0]?.alternatives?.[0]?.transcript || '';

      if (transcript) {
        let displayText = transcript;

        if (diarize && data.results?.channels?.[0]?.alternatives?.[0]?.words) {
          const words = data.results.channels[0].alternatives[0].words;
          let currentSpeaker = -1;
          let parts: string[] = [];
          for (const w of words) {
            if (w.speaker !== currentSpeaker) {
              currentSpeaker = w.speaker;
              parts.push(`\n[Speaker ${w.speaker}]: `);
            }
            parts.push(w.punctuated_word || w.word);
            parts.push(' ');
          }
          displayText = parts.join('').trim();
        }

        fileTranscript.textContent = displayText;
        uploadStatus.textContent = `Transcription complete for "${file.name}".`;
      } else {
        fileTranscript.innerHTML = '<p class="placeholder">No speech detected in the audio file.</p>';
        uploadStatus.textContent = 'Transcription returned no results.';
      }
    } catch (err: any) {
      uploadStatus.textContent = `Error: ${err.message}`;
      fileTranscript.innerHTML = `<p class="placeholder">Transcription failed. ${err.message}</p>`;
    }
  }
</script>
