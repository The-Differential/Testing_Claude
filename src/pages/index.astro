---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Features from '../components/Features.astro';
import Apps from '../components/Apps.astro';
import Download from '../components/Download.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout
  title="MedTools - Professional Medical Apps for Healthcare Professionals"
  description="Comprehensive drug dosing information and medical calculators for healthcare professionals. Access thousands of medications and clinical tools offline."
>
  <Header />
  <main>
    <Hero />
    <Features />
    <Apps />
    <Download />
  </main>
  <Footer />
</BaseLayout>

<style>
  main {
    min-height: 100vh;
  }
</style>
